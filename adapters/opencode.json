{
  "name": "local-memory-fabric",
  "version": "1.8.0",
  "description": "Deterministic local-first memory index for OpenCode & Codex IDE workflows",
  "command": "python3",
  "args": ["adapters/mcp.py"],
  "tools": [
    "memory_fabric_search",
    "memory_fabric_context",
    "memory_fabric_read",
    "memory_fabric_propose",
    "memory_fabric_sections",
    "memory_fabric_compact",
    "memory_fabric_federate"
  ],
  "features": {
    "zero_bust_kv_prefix": true,
    "parameter_coercion": true
  }
}
